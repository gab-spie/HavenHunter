# Copy to .env and fill in. Never commit the filled version.
# Loaded into the process environment; config.yaml stays secret-free.

# Telegram bot, from BotFather
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Optional, comma-separated extra chat/user ids allowed to control the bot.
# TELEGRAM_CHAT_ID is always allowed; this only adds to it.
TELEGRAM_ALLOWED_IDS=

# Optional Google Sheets logging. Absent = logging is a no-op.
SHEETS_CREDENTIALS_PATH=
SHEETS_SPREADSHEET=

# Optional persistent dedup store (hosted database)
DEDUP_URL=
DEDUP_KEY=

# Optional unattended scanning. Minutes between automatic scans.
# 0 (default) disables it and you drive scans by hand with /scan.
SCAN_INTERVAL_MINUTES=0

# Optional. Seconds a single source gets to answer before it counts as
# failed. Default 30.
SOURCE_FETCH_TIMEOUT_SECONDS=30
